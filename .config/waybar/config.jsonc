// After editing: pkill waybar ; uwsm app -- waybar &
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": [
        "custom/power",
        "hyprland/workspaces",
        "group/toggles",
        "group/volume",
        "group/brightness",
        "mpris"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "privacy",
        "hyprland/submap",
        "group/hardware",
        "tray",
        "group/datetime"
    ],

    "hyprland/workspaces": {
        "disable-scroll": false,
        "on-click": "activate",
        // Workspace number, then an icon per window. Only workspaces with
        // windows (or the active one) are shown. Title rules come first so
        // yazi/nvim inside kitty get their own icon.
        "format": "{id} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "󰣆",
        "window-rewrite": {
            "title<.*yazi.*>": "󰉋", // yazi in kitty: folder
            "title<.*n?vim.*>": "", // Neovim in kitty
            "class<popup\\..*|keys\\.cheatsheet>": "", // bar popups and the cheat sheet: no icon
            "class<kitty>": "󰆍",
            "class<brave-browser>": "󰖟",
            "class<signal>": "󰭹",
            "class<mpv>": "󰐹",
            "class<com.gabm.satty>": "󰏫",
            "class<steam>": "󰓓",
            "class<org.pulseaudio.pavucontrol>": "󰕾",
            "class<blueman-.*>": "󰂯",
            "class<nm-connection-editor>": "󰖩",
            "class<[Bb]itwarden>": "󰌆"
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },

    "keyboard-state": {
        "numlock": false,
        "capslock": false,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },

    // Title of the focused window
    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true
    },

    // 24-hour clock; hover for a calendar with week numbers, click for the full date
    // Clock: weekday, short date and time show; the week number slides out (to
    // the left) on hover; the calendar tooltip is on it. SUPER + CTRL + C shows the month.
    "group/datetime": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 300, "transition-left-to-right": false },
        "modules": ["clock#time", "clock#date"]
    },
    "clock#date": {
        "format": "W{:%V}",
        "tooltip": false
    },
    "clock#time": {
        // The date in normal weight, so the (bold) time stands out
        // Waybar's clock allows one placeholder, whose spec must start with %, so
        // the <span> opens before it and closes inside it
        "format": "<span weight='normal'>{:%a %d.%m</span>  %H:%M}",
        //"format-alt": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        //"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        // ISO week numbers (%V), as used in Denmark and by cal and the date above
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "format": {
                "weeks": "<span color='#7f849c'>W{:%V}</span>",
                "today": "<span color='#a6e3a1'><b>{}</b></span>"
            }
        }
    },

    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% \ue266",
        "tooltip": true,
	    "tooltip-format": "{used:0.1f}GB/{total:0.1f}G"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        // Icon only: the slider shows the level, the tooltip the exact value
        "format": "{icon}",
        "tooltip-format": "Brightness {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },
    // Icons of apps that put themselves in the tray (Steam, Discord, ...).
    // nm-applet lives here too: Wi-Fi status and its connection menu.
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    // Now playing from any MPRIS player (browser, mpv, Spotify, ...).
    // Hidden when nothing is playing. Click: play/pause, middle: previous, right: next
    "mpris": {
        // Title only (browsers can report the artist as "null"); artist in the tooltip
        "format": "{player_icon} {title}",
        "format-paused": "{status_icon} {title}",
        "title-len": 30,
        "player-icons": {
            "default": "󰎆",
            "brave": "󰖟",
            "mpv": "󰐹",
            "spotify": "󰓇"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "tooltip-format": "{player}: {artist} - {title}\n{album}"
    },
    // Stay awake: no dimming, locking or suspending (also SUPER + CTRL + I). Refreshed with signal 9
    // Shows the active Hyprland submap (e.g. "resize" after SUPER + R); hidden otherwise
    "hyprland/submap": {
        "format": "󰩨  {}",
        "tooltip": false
    },
    // Only visible while the microphone or screen sharing is in use
    // (Waybar can't watch the camera)
    "privacy": {
        "icon-size": 14,
        "icon-spacing": 6,
        "modules": [
            { "type": "screenshare", "tooltip": true },
            { "type": "audio-in", "tooltip": true }
        ]
    },
    "custom/idle": {
        "exec": "~/.config/hypr/scripts/idle-inhibit.sh status",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.config/hypr/scripts/idle-inhibit.sh toggle"
    },
    "custom/notifications": {
        "exec": "~/.config/waybar/scripts/mako-dnd.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "makoctl mode -t do-not-disturb; pkill -RTMIN+8 waybar"
    },
    // Volume and brightness: the icon shows, its slider slides out on hover.
    // Fine as mouse-only extras because both levels are on keys too.
    "group/volume": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 300, "transition-left-to-right": true },
        "modules": ["wireplumber", "pulseaudio/slider"]
    },
    "group/brightness": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 300, "transition-left-to-right": true },
        "modules": ["backlight", "backlight/slider"]
    },
    // Plain groups (no drawer): one pill each on the bar
    "group/hardware": { "orientation": "horizontal", "modules": ["cpu", "memory", "temperature", "battery"] },
    "group/toggles": {
        "orientation": "horizontal",
        "modules": ["custom/idle", "custom/notifications", "power-profiles-daemon", "bluetooth"]
    },

    // Sliders next to the volume and brightness icons (both also have keys)
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    // Never below 5%, so a stray drag can't black out the screen
    "backlight/slider": {
        "min": 5,
        "max": 100,
        "orientation": "horizontal"
    },
    // Volume: scroll to change
    "wireplumber": {
        // Icon only: the slider shows the level, the tooltip the exact value
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": ["", " ", " "],
        "scroll-step": 5,
        "tooltip-format": "{volume}% · {node_name}",
//        "on-click": "~/.config/hypr/scripts/toggle-popup.sh popup.mixer wiremix",
        //"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // Click to manage devices, right-click to turn Bluetooth on/off
    "bluetooth": {
        "format": "",
        "format-off": "",
        "format-disabled": "",
        "format-connected": "{num_connections} ",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "~/.config/hypr/scripts/toggle-popup.sh popup.bluetooth bluetui",
        "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
    },

    "battery": {
        // Nerd Font battery glyphs (the emoji 🗲 came from the emoji font and looked bigger)
        "states": { "warning": 25, "critical": 10 },
        "format": "{capacity}% {icon}",
        "format-alt": "{time} {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰚥",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}",
        //"on-click": "case $(powerprofilesctl get) in power-saver) n=balanced ;; balanced) n=performance ;; *) n=power-saver ;; esac; powerprofilesctl set $n || powerprofilesctl set power-saver"
    },

    // Leaf = power-saver, scales = balanced, gauge = performance
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "format-icons": {
            "default": "󰊚",
            "performance": "󰡴",
            "balanced": "󰊚",
            "power-saver": "󰡵"
        }
    },

    // Power menu (lock, log out, suspend, reboot, shut down)
    "custom/power": {
        "format": "",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power-menu.xml",
        "menu-actions": {
            "lock": "loginctl lock-session",
            "logout": "uwsm stop",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
