#!/usr/bin/env lua
-- ~/.config/theme/apply
-- Regenerates each app's colour file from palette.lua and reloads the apps.
-- Hyprland reads palette.lua itself; this only reloads it.

local dir = os.getenv("HOME") .. "/.config/theme"
local p = dofile(dir .. "/palette.lua")
local header = "Generated by ~/.config/theme/apply from palette.lua. Don't edit; edit the palette and re-run apply."

local function write(name, text)
	local f = assert(io.open(dir .. "/generated/" .. name, "w"))
	f:write(text)
	f:close()
end

-- "141418", 0.85 -> "d9"
local function alpha_hex(a)
	return string.format("%02x", math.floor(a * 255 + 0.5))
end

-- "141418", 0.85 -> "rgba(20, 20, 24, 0.85)"
local function css_rgba(hex, a)
	local r, g, b = tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
	return string.format("rgba(%d, %d, %d, %s)", r, g, b, a)
end

local a = alpha_hex(p.bg_alpha)

write("waybar.css", ([[
/* %s */
@define-color bg      %s;
@define-color bg2     %s;
@define-color fg      #%s;
@define-color dim     #%s;
@define-color muted   #%s;
@define-color accent  #%s;
@define-color accent2 #%s;
@define-color warn    #%s;
@define-color crit    #%s;
]]):format(header, css_rgba(p.bg, p.bg_alpha), css_rgba(p.surface, p.bg_alpha),
	p.fg, p.dim, p.muted, p.accent, p.accent2, p.warn, p.crit))

write("mako.conf", ([[
# %s
background-color=#%s%s
text-color=#%s
border-color=#%s
progress-color=over #%s

[urgency=low]
border-color=#%s

[urgency=high]
border-color=#%s
]]):format(header, p.bg, a, p.fg, p.accent, p.surface, p.dim, p.crit))

write("fuzzel.ini", ([[
# %s
[colors]
background=%s%s
text=%sff
prompt=%sff
input=%sff
placeholder=%sff
match=%sff
selection=%sff
selection-text=%sff
selection-match=%sff
counter=%sff
border=%sff
]]):format(header, p.bg, a, p.fg, p.accent, p.fg, p.dim, p.accent2, p.surface,
	p.fg_bright, p.accent2, p.dim, p.accent))

-- Accents use "ee" alpha, like the Hyprland window borders
write("hyprlock.conf", ([[
# %s
$fg = rgb(%s)
$accent = rgba(%see)
$accent2 = rgba(%see)
$warn = rgba(%see)
$crit = rgba(%see)
]]):format(header, p.fg, p.accent, p.accent2, p.warn, p.crit))

-- Waybar's config.jsonc can't include files, so patch the two calendar colours in place
local cfg = os.getenv("HOME") .. "/.config/waybar/config.jsonc"
local f = assert(io.open(cfg))
local json = f:read("a")
f:close()
json = json:gsub([["weeks": "<span color='#%x+'>]], [["weeks": "<span color='#]] .. p.muted .. [['>]])
json = json:gsub([["today": "<span color='#%x+'>]], [["today": "<span color='#]] .. p.accent2 .. [['>]])
f = assert(io.open(cfg, "w"))
f:write(json)
f:close()

os.execute("hyprctl reload >/dev/null 2>&1")
os.execute("makoctl reload >/dev/null 2>&1")
os.execute("pkill -SIGUSR2 -x waybar")
print("Theme applied. fuzzel and hyprlock pick it up the next time they open.")
