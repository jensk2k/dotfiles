#!/usr/bin/env lua
-- ~/.config/theme/apply [THEME | --pick]
--
-- Switches the desktop to one of the colour schemes in schemes.lua: kitty and
-- Neovim use the scheme's official ports; our own UI (Waybar, mako, fuzzel,
-- hyprlock, SDDM, Hyprland borders) gets a palette derived from its kitty
-- colours, written to generated/. Then everything is reloaded.
--   apply           re-apply the scheme set in palette.lua
--   apply "Nord"    switch to another scheme from schemes.lua (saved in palette.lua)
--   apply --pick    choose a theme in fuzzel
--   apply --previous  switch back to the theme before the last switch

local home = os.getenv("HOME")
local dir = home .. "/.config/theme"
local config = dofile(dir .. "/palette.lua")
local schemes = dofile(dir .. "/schemes.lua")
local ports = dofile(dir .. "/ports.lua")
local scheme_by_name = {}
for _, s in ipairs(schemes) do
	scheme_by_name[s.name] = s
end
-- Older palette.lua files used kitty theme names ("Catppuccin-Mocha"); map
-- those to scheme names, so favourites and the current theme carry over
local name_of_kitty = {}
for _, s in ipairs(schemes) do
	name_of_kitty[s.kitty] = s.name
end
local function scheme_name(n)
	return scheme_by_name[n] and n or name_of_kitty[n] or n
end
config.theme = scheme_name(config.theme)
for i, n in ipairs(config.favorites or {}) do
	config.favorites[i] = scheme_name(n)
end
local header = "Generated by ~/.config/theme/apply. Don't edit; edit palette.lua and re-run apply."

local function read(path)
	local f = assert(io.open(path))
	local text = f:read("a")
	f:close()
	return text
end

local function write(path, text)
	local f = assert(io.open(path, "w"))
	f:write(text)
	f:close()
end

local function capture(cmd)
	local f = assert(io.popen(cmd))
	local out = f:read("a")
	f:close()
	return out
end

local function shell_quote(s)
	return "'" .. s:gsub("'", "'\\''") .. "'"
end

-- The theme active before the last switch, for --previous and the picker's
-- top line. Session history, so it lives in ~/.local/state, not in the repo.
local previous_file = home .. "/.local/state/theme/previous"
local function previous_theme()
	local f = io.open(previous_file)
	if not f then
		return nil
	end
	local name = f:read("l")
	f:close()
	return name and name ~= "" and scheme_name(name) or nil
end

---- Colours ----

local function rgb(hex)
	return tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
end

-- Blend two hex colours; t = 0 gives a, t = 1 gives b
local function mix(a, b, t)
	local r1, g1, b1 = rgb(a)
	local r2, g2, b2 = rgb(b)
	local function m(x, y) return math.floor(x + (y - x) * t + 0.5) end
	return string.format("%02x%02x%02x", m(r1, r2), m(g1, g2), m(b1, b2))
end

-- WCAG relative luminance and contrast ratio
local function luminance(hex)
	local function c(v)
		v = v / 255
		return v <= 0.03928 and v / 12.92 or ((v + 0.055) / 1.055) ^ 2.4
	end
	local r, g, b = rgb(hex)
	return 0.2126 * c(r) + 0.7152 * c(g) + 0.0722 * c(b)
end
local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	return (math.max(la, lb) + 0.05) / (math.min(la, lb) + 0.05)
end

-- The desktop palette for one theme, from its kitty colours (background,
-- foreground, color0..15 as lowercase hex) plus any overrides in palette.lua.
-- For the four colour slots, the normal or bright ANSI variant, whichever
-- stands out more on bg. Used by both the picker swatches and apply itself.
local function derive(kitty, theme)
	local function pick(normal, bright)
		local a, b = kitty["color" .. normal], kitty["color" .. bright] or kitty["color" .. normal]
		return contrast(b, kitty.background) > contrast(a, kitty.background) and b or a
	end
	local p = {
		bg = kitty.background,
		fg = kitty.foreground,
		surface = mix(kitty.background, kitty.foreground, 0.12),
		dim = mix(kitty.background, kitty.foreground, 0.45),
		accent = pick(4, 12),
		accent2 = pick(2, 10),
		warn = pick(3, 11),
		crit = pick(1, 9),
	}
	-- The family's official palette (its Waybar port), when downloaded: each slot
	-- takes the colour schemes.lua's map names. Used exactly as published.
	local entry = scheme_by_name[theme]
	local official = entry and entry.palette and ports.palette_colors(ports.path("palette", entry))
	if official then
		for slot, name in pairs(entry.palette.map) do
			p[slot] = official[name] or p[slot]
		end
	end

	-- Contrast safeguard, for derived palettes only: an accent slot that's too
	-- faint on bg (under 3:1, the usual minimum for borders and icons) is
	-- darkened on light themes or lightened on dark ones, in small steps, until
	-- it passes. The hue stays. Returns the adjusted slot names; overrides below
	-- are never adjusted.
	local adjusted = {}
	local towards = luminance(p.bg) > luminance(p.fg) and "000000" or "ffffff"
	for _, slot in ipairs({ "accent", "accent2", "warn", "crit" }) do
		if not official and contrast(p[slot], p.bg) < 3 then
			local base, t = p[slot], 0
			repeat
				t = t + 0.02
				p[slot] = mix(base, towards, t)
			until contrast(p[slot], p.bg) >= 3 or t >= 1
			adjusted[#adjusted + 1] = slot
		end
	end
	for slot, hex in pairs((config.overrides or {})[theme] or {}) do
		p[slot] = hex:lower()
		for i, s in ipairs(adjusted) do
			if s == slot then
				table.remove(adjusted, i)
			end
		end
	end
	return p, adjusted, official ~= nil
end


---- Choosing a theme ----

-- Every theme's kitty colours from kitty's theme archive, in one pass:
-- { ["Theme Name"] = { background = "282a36", color1 = "ff5555", ... }, ... }
local function all_theme_colours()
	local zip = home .. "/.cache/kitty/kitty-themes.zip"
	local themes, current = {}, nil
	-- `unzip -c` prints "inflating: <file>" before each file. Not every theme file
	-- has a "## name:" line, so start fresh at each file, or an unnamed file's
	-- colours would overwrite the previous named theme.
	for line in capture("unzip -c " .. shell_quote(zip) .. " '*/themes/*.conf' 2>/dev/null"):gmatch("[^\r\n]+") do
		local name = line:match("^##%s*name:%s*(.-)%s*$")
		if line:match("^%s*inflating: ") then
			current = nil
		elseif name then
			current = {}
			themes[name] = current
		elseif current then
			local key, hex = line:match("^([%w_]+)%s+#(%x%x%x%x%x%x)")
			if key then
				current[key] = hex:lower()
			end
		end
	end
	return themes
end

-- An SVG icon of a palette, built for being read at a glance: a bg field
-- with fg and dim "text" bars, over solid stripes of accent, accent2, warn
-- and crit
local function swatch(p)
	return ([[<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="48" height="48">
<clipPath id="r"><rect width="48" height="48" rx="6"/></clipPath>
<g clip-path="url(#r)">
<rect width="48" height="48" fill="#%s"/>
<rect x="6" y="7" width="36" height="5" rx="2.5" fill="#%s"/>
<rect x="6" y="16" width="22" height="5" rx="2.5" fill="#%s"/>
<rect x="0" y="28" width="12" height="20" fill="#%s"/>
<rect x="12" y="28" width="12" height="20" fill="#%s"/>
<rect x="24" y="28" width="12" height="20" fill="#%s"/>
<rect x="36" y="28" width="12" height="20" fill="#%s"/>
</g>
<rect x="0.5" y="0.5" width="47" height="47" rx="6" fill="none" stroke="#%s"/>
</svg>
]]):format(p.bg, p.fg, p.dim, p.accent, p.accent2, p.warn, p.crit, p.dim)
end

-- Line prefixes in the picker: the current theme, favourites, everything else
-- (same width, so names line up). unmark() strips them from fuzzel's answer.
local markers = { current = "✓ ", favorite = "★ ", previous = "↶ " }
local function marker(kind)
	return markers[kind] or "  "
end
local function unmark(line)
	for _, m in ipairs({ markers.current, markers.favorite, markers.previous, "  " }) do
		if line:sub(1, #m) == m then
			return line:sub(#m + 1)
		end
	end
	return line
end

-- Favourites first, then every other complete named theme alphabetically, each
-- with its palette swatch (shown large: the picker uses tall lines) (cached in ~/.cache/theme-swatches) as the fuzzel icon
local function picker_lines()
	local colours = all_theme_colours()
	-- Favourites first, then the rest of schemes.lua in its own (family) order
	local names, seen = {}, {}
	for _, n in ipairs(config.favorites or {}) do
		if scheme_by_name[n] and not seen[n] then
			names[#names + 1], seen[n] = n, true
		end
	end
	for _, s in ipairs(schemes) do
		if not seen[s.name] then
			names[#names + 1], seen[s.name] = s.name, true
		end
	end

	local favorite = {}
	for _, n in ipairs(config.favorites or {}) do
		favorite[n] = true
	end

	local cache = home .. "/.cache/theme-swatches"
	os.execute("mkdir -p " .. shell_quote(cache))
	local lines, icons = {}, {}
	for _, n in ipairs(names) do
		-- Themes without background/foreground/red can't be applied, so leave them out
		local k = colours[scheme_by_name[n].kitty]
		if k and k.background and k.foreground and k.color1 then
			local icon = cache .. "/" .. n:gsub("[^%w]+", "_") .. ".svg"
			local pal = derive(k, n)
			write(icon, swatch(pal))
			icons[n] = icon
			-- Hidden second column, searched but not shown (--match-nth), so typing
			-- "light", "dark" or "fav" filters the list
			local tags = (luminance(pal.bg) > luminance(pal.fg) and "light" or "dark")
				.. (favorite[n] and " favorite" or "")
			lines[#lines + 1] = marker(n == config.theme and "current" or favorite[n] and "favorite")
				.. n .. "\t" .. tags .. "\0icon\x1f" .. icon
		end
	end
	-- The theme before the last switch goes first, so going back is one Enter
	local previous = previous_theme()
	if previous and previous ~= config.theme and icons[previous] then
		table.insert(lines, 1, markers.previous .. previous .. "\tprevious\0icon\x1f" .. icons[previous])
	end
	return lines
end

-- Rewrite the favorites list in palette.lua (the rest of the file is kept)
local function save_favorites()
	local body = {}
	for _, n in ipairs(config.favorites) do
		-- Only schemes on the list; anything else drops out here
		if scheme_by_name[n] then
			body[#body + 1] = '\t\t"' .. n:gsub('[\\"]', "\\%0") .. '",'
		end
	end
	local src = read(dir .. "/palette.lua")
	src = src:gsub("\tfavorites = {.-\n\t},", function()
		return "\tfavorites = {\n" .. table.concat(body, "\n") .. "\n\t},"
	end, 1)
	write(dir .. "/palette.lua", src)
end

local function toggle_favorite(name)
	config.favorites = config.favorites or {}
	for i, n in ipairs(config.favorites) do
		if n == name then
			table.remove(config.favorites, i)
			return save_favorites()
		end
	end
	table.insert(config.favorites, name)
	save_favorites()
end

local theme = arg[1]
if theme == "--previous" then
	theme = previous_theme()
	if not theme then
		io.stderr:write("apply: no previous theme yet\n")
		os.execute("notify-send --app-name=theme 'No previous theme yet' >/dev/null 2>&1")
		os.exit(1)
	end
elseif theme == "--pick" then
	-- Tall lines for big swatches; opaque (current theme's bg) so nothing behind
	-- the menu competes with the colours
	local bg = read(dir .. "/generated/palette.lua"):match('bg = "(%x+)"') or "000000"
	local list = os.tmpname()
	local select = config.theme
	-- Enter applies; Ctrl+S (fuzzel's custom-1, exit code 10; bound in
	-- fuzzel-picker.ini) toggles the highlighted theme as a favourite and
	-- reopens the picker on it
	while true do
		local lines, index = picker_lines(), 0
		for i, line in ipairs(lines) do
			if unmark(line:match("^[^%z\t]*")) == select then
				index = i - 1
			end
		end
		write(list, table.concat(lines, "\n") .. "\n")
		local f = assert(io.popen("fuzzel --config " .. shell_quote(dir .. "/fuzzel-picker.ini")
			.. " --dmenu --prompt 'Theme ❯ ' --placeholder 'Ctrl+S toggles ★ · type light, dark or fav'"
			.. " --with-nth=1 --accept-nth=1 --match-nth='{1} {2}'"
			.. " --line-height 44 --lines 9 --width 44 --background-color " .. bg .. "ff"
			.. " --select-index " .. index .. " < " .. list))
		local out = f:read("a"):gsub("\n$", "")
		local _, _, code = f:close()
		theme = unmark(out)
		if code == 10 and theme ~= "" then
			toggle_favorite(theme)
			select = theme
		else
			break
		end
	end
	os.remove(list)
	if theme == "" then
		os.exit(0)
	end
end
theme = scheme_name(theme or config.theme)

---- Reading the scheme's colours from its kitty theme ----

local scheme = scheme_by_name[theme]
if not scheme then
	io.stderr:write("apply: '" .. theme .. "' isn't one of the schemes in ~/.config/theme/schemes.lua\n")
	os.execute("notify-send --app-name=theme " .. shell_quote("Theme: '" .. theme .. "' isn't on the list") .. " >/dev/null 2>&1")
	os.exit(1)
end
local dump = capture("kitten themes --dump-theme " .. shell_quote(scheme.kitty) .. " 2>/dev/null")
local kitty = {}
for key, hex in dump:gmatch("\n?([%w_]+)%s+#(%x%x%x%x%x%x)") do
	kitty[key] = hex:lower()
end
if not (kitty.background and kitty.foreground and kitty.color1) then
	io.stderr:write("apply: kitty doesn't know the theme '" .. scheme.kitty .. "' (see `kitten themes`)\n")
	os.exit(1)
end

local p, adjusted, official_palette = derive(kitty, theme)
local missing_palette = type(scheme.palette) == "table" and not official_palette

-- A scheme's port for one app: a built-in theme name (string) or the path of a
-- fetched port (see schemes.lua). nil when there's none, or when the port
-- isn't downloaded yet (then noted in `missing`); callers fall back.
local function exists(path)
	local f = io.open(path)
	if f then
		f:close()
	end
	return f ~= nil
end
local missing = {}
local function port(tool)
	local entry = scheme[tool]
	if type(entry) == "table" then
		local path = ports.path(tool, scheme)
		if exists(path) then
			return path
		end
		missing[#missing + 1] = tool
	end
	return type(entry) == "string" and entry or nil
end


---- Writing each app's colour file ----

local gen = dir .. "/generated/"
local a = string.format("%02x", math.floor(config.bg_alpha * 255 + 0.5))
local function css_rgba(hex, alpha)
	local r, g, b = rgb(hex)
	return string.format("rgba(%d, %d, %d, %s)", r, g, b, alpha)
end

write(gen .. "palette.lua", ([[
-- %s
-- Theme: %s
return {
	bg = "%s",
	surface = "%s",
	fg = "%s",
	dim = "%s",
	accent = "%s",
	accent2 = "%s",
	warn = "%s",
	crit = "%s",
}
]]):format(header, theme, p.bg, p.surface, p.fg, p.dim, p.accent, p.accent2, p.warn, p.crit))

write(gen .. "waybar.css", ([[
/* %s */
@define-color bg      %s;
@define-color bg2     %s;
@define-color fg      #%s;
@define-color dim     #%s;
@define-color accent  #%s;
@define-color accent2 #%s;
@define-color warn    #%s;
@define-color crit    #%s;
]]):format(header, css_rgba(p.bg, config.bg_alpha), css_rgba(p.surface, config.bg_alpha),
	p.fg, p.dim, p.accent, p.accent2, p.warn, p.crit))

-- mako and fuzzel: the family's own colour config when it has one (used as-is),
-- otherwise our colour choices from the slots
local function official_config(tool)
	local path = port(tool)
	return path and ("# %s\n# The colour scheme's official %s colours: %s\n\n%s"):format(
		header, tool, scheme[tool].url, read(path))
end

local mako_port = official_config("mako")
if mako_port then
	write(gen .. "mako.conf", mako_port)
else
write(gen .. "mako.conf", ([[
# %s
background-color=#%s%s
text-color=#%s
border-color=#%s
progress-color=over #%s

[urgency=low]
border-color=#%s

[urgency=high]
border-color=#%s
]]):format(header, p.bg, a, p.fg, p.accent, p.surface, p.dim, p.crit))
end

local fuzzel_port = official_config("fuzzel")
if fuzzel_port then
	write(gen .. "fuzzel.ini", fuzzel_port)
else
write(gen .. "fuzzel.ini", ([[
# %s
[colors]
background=%s%s
text=%sff
prompt=%sff
input=%sff
placeholder=%sff
match=%sff
selection=%sff
selection-text=%sff
selection-match=%sff
counter=%sff
border=%sff
]]):format(header, p.bg, a, p.fg, p.accent, p.fg, p.dim, p.accent2, p.surface,
	p.fg, p.accent2, p.dim, p.accent))
end

write(gen .. "hyprlock.conf", ([[
# %s
$bg = rgb(%s)
$fg = rgb(%s)
$accent = rgba(%see)
$accent2 = rgba(%see)
$warn = rgba(%see)
$crit = rgba(%see)
]]):format(header, p.bg, p.fg, p.accent, p.accent2, p.warn, p.crit))

-- SDDM login theme. SDDM can't read $HOME, so the colours are also copied to
-- the installed theme, whose theme.conf.user `sudo ~/.config/sddm/install`
-- makes ours (see the end).
local sddm_colors = home .. "/.config/sddm/theme/theme.conf.user"
write(sddm_colors, ([[
; %s
[General]
Bg="#%s"
Surface="#%s"
Fg="#%s"
Dim="#%s"
Accent="#%s"
Accent2="#%s"
Warn="#%s"
Crit="#%s"
]]):format(header, p.bg, p.surface, p.fg, p.dim, p.accent, p.accent2, p.warn, p.crit))

-- Waybar's config.jsonc can't include files, so patch the two calendar colours in place
local cfg = home .. "/.config/waybar/config.jsonc"
local json = read(cfg)
json = json:gsub([["weeks": "<span color='#%x+'>]], [["weeks": "<span color='#]] .. p.dim .. [['>]])
json = json:gsub([["today": "<span color='#%x+'>]], [["today": "<span color='#]] .. p.accent2 .. [['>]])
write(cfg, json)

-- Remember the theme for the next plain `apply`, and the one we left for --previous
if theme ~= config.theme then
	os.execute("mkdir -p " .. shell_quote(home .. "/.local/state/theme"))
	write(previous_file, config.theme .. "\n")
	local src = read(dir .. "/palette.lua")
	src = src:gsub('\ttheme = "[^"\n]*"', function() return '\ttheme = "' .. theme .. '"' end, 1)
	write(dir .. "/palette.lua", src)
end

---- Light or dark, for everything outside the palette ----

-- A theme is light when its background is lighter than its text. GTK apps,
-- the icon theme, and (through xdg-desktop-portal) browsers and websites
-- follow the system colour-scheme setting, so switch it to match.
local light = luminance(p.bg) > luminance(p.fg)

-- Neovim: the scheme's official colorscheme (plugins/colorscheme.lua reads this
-- and open Neovims switch when it changes)
write(gen .. "nvim.lua", ([[
-- %s
return { colorscheme = %q, background = %q }
]]):format(header, scheme.nvim.colorscheme, scheme.nvim.background or (light and "light" or "dark")))
local color_scheme = light and "prefer-light" or "prefer-dark"
local gtk_theme = light and "Adwaita" or "Adwaita-dark"
local icons = light and "Papirus" or "Papirus-Dark"
for key, value in pairs({ ["color-scheme"] = color_scheme, ["gtk-theme"] = gtk_theme, ["icon-theme"] = icons }) do
	os.execute("gsettings set org.gnome.desktop.interface " .. key .. " " .. value .. " 2>/dev/null")
end
-- Older GTK 3 apps read settings.ini instead (written by nwg-look; not tracked)
for _, ini in ipairs({ "/.config/gtk-3.0/settings.ini", "/.config/gtk-4.0/settings.ini" }) do
	local f = io.open(home .. ini)
	if f then
		local text = f:read("a")
		f:close()
		text = text:gsub("gtk%-theme%-name=[^\n]*", "gtk-theme-name=" .. gtk_theme)
			:gsub("gtk%-icon%-theme%-name=[^\n]*", "gtk-icon-theme-name=" .. icons)
			:gsub("gtk%-application%-prefer%-dark%-theme=[^\n]*", "gtk-application-prefer-dark-theme=" .. (light and 0 or 1))
		write(home .. ini, text)
	end
end

---- Terminal apps: the scheme's own btop, bat and fzf themes ----

-- btop reads color_theme (a built-in name or a theme file) when it starts
local btop_conf = home .. "/.config/btop/btop.conf"
if exists(btop_conf) then
	local btop = port("btop") or "TTY"
	local conf = read(btop_conf):gsub('color_theme = "[^"\n]*"', function() return 'color_theme = "' .. btop .. '"' end, 1)
	write(btop_conf, conf)
end

-- bat reads its config on every run; fetched themes go by their file name
local bat = port("bat")
if bat and bat:match("%.tmTheme$") then
	bat = ports.bat_name(scheme)
end
write(home .. "/.config/bat/config", ([[
# Generated by ~/.config/theme/apply: the colour scheme's bat theme
# ("ansi" = the terminal's colours, for schemes without a bat port)
--theme=%s
]]):format(shell_quote(bat or "ansi")))

-- fzf reads FZF_DEFAULT_OPTS_FILE (set in .zshrc) on every run: the port's
-- --color options, or the terminal's 16 colours
local fzf = port("fzf")
write(gen .. "fzf.opts", (fzf and ports.fzf_colors(fzf) or "--color=16") .. "\n")

---- Reloading ----

-- kitty: writes ~/.config/kitty/current-theme.conf and recolours open windows
os.execute("kitten themes --reload-in=all " .. shell_quote(scheme.kitty) .. " >/dev/null 2>&1")
os.execute("hyprctl reload >/dev/null 2>&1")
os.execute("makoctl reload >/dev/null 2>&1")
os.execute("pkill -SIGUSR2 -x waybar")
os.execute("notify-send --app-name=theme 'Theme: " .. theme:gsub("'", "") .. "' >/dev/null 2>&1")
print("Theme applied: " .. theme .. (light and " (light)" or " (dark)"))
print("Official: kitty, Neovim" .. (official_palette and ", palette (our UI)" or "")
	.. (mako_port and ", mako" or "") .. (fuzzel_port and ", fuzzel" or ""))
if missing_palette then
	table.insert(missing, 1, "palette")
end
if #missing > 0 then
	print("Not downloaded yet, using fallbacks: " .. table.concat(missing, ", ") .. "; run ~/.config/theme/fetch-ports")
end
if #adjusted > 0 then
	print(("Adjusted for contrast (%s): %s"):format(light and "darker" or "lighter", table.concat(adjusted, ", ")))
end

local installed_path = "/usr/share/sddm/themes/dotfiles/theme.conf.user"
local installed = io.open(installed_path)
if installed then
	local same = installed:read("a") == read(sddm_colors)
	installed:close()
	if not same then
		local f = io.open(installed_path, "w")
		if f then
			f:write(read(sddm_colors))
			f:close()
		else
			print("Login screen still has the old colours: sudo ~/.config/sddm/install (once; later switches update it themselves)")
		end
	end
end
