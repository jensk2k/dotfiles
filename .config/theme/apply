#!/usr/bin/env lua
-- ~/.config/theme/apply [THEME | --pick]
--
-- Builds the desktop palette from the kitty theme named in palette.lua, writes
-- each app's colour file to generated/, switches kitty to the same theme and
-- reloads everything.
--   apply           re-apply the theme set in palette.lua
--   apply "Nord"    switch to another kitty theme (saved in palette.lua)
--   apply --pick    choose a theme in fuzzel

local home = os.getenv("HOME")
local dir = home .. "/.config/theme"
local config = dofile(dir .. "/palette.lua")
local header = "Generated by ~/.config/theme/apply. Don't edit; edit palette.lua and re-run apply."

local function read(path)
	local f = assert(io.open(path))
	local text = f:read("a")
	f:close()
	return text
end

local function write(path, text)
	local f = assert(io.open(path, "w"))
	f:write(text)
	f:close()
end

local function capture(cmd)
	local f = assert(io.popen(cmd))
	local out = f:read("a")
	f:close()
	return out
end

local function shell_quote(s)
	return "'" .. s:gsub("'", "'\\''") .. "'"
end

---- Choosing a theme ----

local function all_themes()
	local names, seen = {}, {}
	for _, n in ipairs(config.favorites or {}) do
		names[#names + 1], seen[n] = n, true
	end
	local zip = home .. "/.cache/kitty/kitty-themes.zip"
	local rest = {}
	for n in capture("unzip -p " .. shell_quote(zip) .. " '*/themes/*.conf' 2>/dev/null"):gmatch("## name: ([^\n]+)") do
		if not seen[n] then
			rest[#rest + 1], seen[n] = n, true
		end
	end
	table.sort(rest, function(a, b) return a:lower() < b:lower() end)
	for _, n in ipairs(rest) do
		names[#names + 1] = n
	end
	return names
end

local theme = arg[1]
if theme == "--pick" then
	local list = os.tmpname()
	write(list, table.concat(all_themes(), "\n") .. "\n")
	theme = capture("fuzzel --dmenu --prompt 'Theme ❯ ' --placeholder " .. shell_quote(config.theme) .. " < " .. list):gsub("\n$", "")
	os.remove(list)
	if theme == "" then
		os.exit(0)
	end
end
theme = theme or config.theme

---- Reading the theme's colours from kitty ----

local dump = capture("kitten themes --dump-theme " .. shell_quote(theme) .. " 2>/dev/null")
local kitty = {}
for key, hex in dump:gmatch("\n?([%w_]+)%s+#(%x%x%x%x%x%x)") do
	kitty[key] = hex:lower()
end
if not (kitty.background and kitty.foreground and kitty.color1) then
	io.stderr:write("apply: unknown kitty theme '" .. theme .. "' (see `kitten themes`)\n")
	os.exit(1)
end

local function rgb(hex)
	return tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
end

-- Blend two hex colours; t = 0 gives a, t = 1 gives b
local function mix(a, b, t)
	local r1, g1, b1 = rgb(a)
	local r2, g2, b2 = rgb(b)
	local function m(x, y) return math.floor(x + (y - x) * t + 0.5) end
	return string.format("%02x%02x%02x", m(r1, r2), m(g1, g2), m(b1, b2))
end

-- WCAG relative luminance and contrast ratio
local function luminance(hex)
	local function c(v)
		v = v / 255
		return v <= 0.03928 and v / 12.92 or ((v + 0.055) / 1.055) ^ 2.4
	end
	local r, g, b = rgb(hex)
	return 0.2126 * c(r) + 0.7152 * c(g) + 0.0722 * c(b)
end
local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	return (math.max(la, lb) + 0.05) / (math.min(la, lb) + 0.05)
end

-- The normal or bright variant of an ANSI colour, whichever stands out more on bg
local function pick(normal, bright)
	local a, b = kitty["color" .. normal], kitty["color" .. bright] or kitty["color" .. normal]
	return contrast(b, kitty.background) > contrast(a, kitty.background) and b or a
end

local p = {
	bg = kitty.background,
	fg = kitty.foreground,
	surface = mix(kitty.background, kitty.foreground, 0.12),
	dim = mix(kitty.background, kitty.foreground, 0.45),
	accent = pick(4, 12),
	accent2 = pick(2, 10),
	warn = pick(3, 11),
	crit = pick(1, 9),
}
for slot, hex in pairs((config.overrides or {})[theme] or {}) do
	p[slot] = hex:lower()
end

---- Writing each app's colour file ----

local gen = dir .. "/generated/"
local a = string.format("%02x", math.floor(config.bg_alpha * 255 + 0.5))
local function css_rgba(hex, alpha)
	local r, g, b = rgb(hex)
	return string.format("rgba(%d, %d, %d, %s)", r, g, b, alpha)
end

write(gen .. "palette.lua", ([[
-- %s
-- Theme: %s
return {
	bg = "%s",
	surface = "%s",
	fg = "%s",
	dim = "%s",
	accent = "%s",
	accent2 = "%s",
	warn = "%s",
	crit = "%s",
}
]]):format(header, theme, p.bg, p.surface, p.fg, p.dim, p.accent, p.accent2, p.warn, p.crit))

write(gen .. "waybar.css", ([[
/* %s */
@define-color bg      %s;
@define-color bg2     %s;
@define-color fg      #%s;
@define-color dim     #%s;
@define-color accent  #%s;
@define-color accent2 #%s;
@define-color warn    #%s;
@define-color crit    #%s;
]]):format(header, css_rgba(p.bg, config.bg_alpha), css_rgba(p.surface, config.bg_alpha),
	p.fg, p.dim, p.accent, p.accent2, p.warn, p.crit))

write(gen .. "mako.conf", ([[
# %s
background-color=#%s%s
text-color=#%s
border-color=#%s
progress-color=over #%s

[urgency=low]
border-color=#%s

[urgency=high]
border-color=#%s
]]):format(header, p.bg, a, p.fg, p.accent, p.surface, p.dim, p.crit))

write(gen .. "fuzzel.ini", ([[
# %s
[colors]
background=%s%s
text=%sff
prompt=%sff
input=%sff
placeholder=%sff
match=%sff
selection=%sff
selection-text=%sff
selection-match=%sff
counter=%sff
border=%sff
]]):format(header, p.bg, a, p.fg, p.accent, p.fg, p.dim, p.accent2, p.surface,
	p.fg, p.accent2, p.dim, p.accent))

write(gen .. "hyprlock.conf", ([[
# %s
$bg = rgb(%s)
$fg = rgb(%s)
$accent = rgba(%see)
$accent2 = rgba(%see)
$warn = rgba(%see)
$crit = rgba(%see)
]]):format(header, p.bg, p.fg, p.accent, p.accent2, p.warn, p.crit))

-- SDDM login theme. It lives outside $HOME once installed, so it only updates
-- after `sudo ~/.config/sddm/install` (see the reminder at the end).
local sddm_colors = home .. "/.config/sddm/theme/theme.conf.user"
write(sddm_colors, ([[
; %s
[General]
Bg="#%s"
Surface="#%s"
Fg="#%s"
Dim="#%s"
Accent="#%s"
Accent2="#%s"
Warn="#%s"
Crit="#%s"
]]):format(header, p.bg, p.surface, p.fg, p.dim, p.accent, p.accent2, p.warn, p.crit))

-- Waybar's config.jsonc can't include files, so patch the two calendar colours in place
local cfg = home .. "/.config/waybar/config.jsonc"
local json = read(cfg)
json = json:gsub([["weeks": "<span color='#%x+'>]], [["weeks": "<span color='#]] .. p.dim .. [['>]])
json = json:gsub([["today": "<span color='#%x+'>]], [["today": "<span color='#]] .. p.accent2 .. [['>]])
write(cfg, json)

-- Remember the theme for the next plain `apply`
if theme ~= config.theme then
	local src = read(dir .. "/palette.lua")
	src = src:gsub('\ttheme = "[^"\n]*"', function() return '\ttheme = "' .. theme .. '"' end, 1)
	write(dir .. "/palette.lua", src)
end

---- Reloading ----

-- kitty: writes ~/.config/kitty/current-theme.conf and recolours open windows
os.execute("kitten themes --reload-in=all " .. shell_quote(theme) .. " >/dev/null 2>&1")
os.execute("hyprctl reload >/dev/null 2>&1")
os.execute("makoctl reload >/dev/null 2>&1")
os.execute("pkill -SIGUSR2 -x waybar")
os.execute("notify-send --app-name=theme 'Theme: " .. theme:gsub("'", "") .. "' >/dev/null 2>&1")
print("Theme applied: " .. theme)

local installed = io.open("/usr/share/sddm/themes/dotfiles/theme.conf.user")
if installed then
	local same = installed:read("a") == read(sddm_colors)
	installed:close()
	if not same then
		print("Login screen still has the old colours: sudo ~/.config/sddm/install")
	end
end
