# Session environment, read by uwsm before Hyprland starts
export XCURSOR_SIZE=24
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME=Adwaita
# No GTK_THEME here: it would force one theme on all GTK apps. ~/.config/theme/apply
# sets light or dark (gsettings color-scheme, gtk-theme, icon-theme) per colour theme.
export QT_QPA_PLATFORMTHEME=qt6ct
# SSH agent: Bitwarden desktop (Settings > Enable SSH agent). The key lives in the
# vault (item type "SSH key"), not in ~/.ssh; the vault must be unlocked to use it.
export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
