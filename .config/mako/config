font=JetBrainsMono Nerd Font 11
anchor=top-right
layer=overlay
margin=8
padding=10,12
width=360
border-size=1
border-radius=6
default-timeout=5000
max-visible=5
icons=1
max-icon-size=48

# Colours come from ~/.config/theme/palette.lua (run ~/.config/theme/apply).
# Keep this include before the first [section] so its colours apply globally.
include=~/.config/theme/generated/mako.conf

[urgency=low]
default-timeout=20000

[urgency=high]
default-timeout=0

[mode=do-not-disturb]
invisible=1

# Optional: let urgent notifications through even in do-not-disturb
[mode=do-not-disturb urgency=high]
invisible=0
