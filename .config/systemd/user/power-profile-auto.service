[Unit]
Description=Switch power profile on charger plug/unplug
PartOf=graphical-session.target
# Laptops only: skipped on a machine without a battery (desktop)
ConditionPathExistsGlob=/sys/class/power_supply/BAT*
After=graphical-session.target

[Service]
ExecStart=%h/.config/hypr/scripts/power-profile-auto.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
