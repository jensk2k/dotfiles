[Unit]
Description=Check the battery every minute for low-battery notifications
PartOf=graphical-session.target
# Laptops only: skipped on a machine without a battery (desktop)
ConditionPathExistsGlob=/sys/class/power_supply/BAT*

[Timer]
OnActiveSec=10s
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=graphical-session.target
